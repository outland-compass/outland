# Studio V0-D1 defaults to the non-production fixture for reads.
STUDIO_DATA_SOURCE=fixture

# Private Studio access gate.
# STUDIO_ACCESS_KEY_HASH = SHA-256 hex digest of the chosen access key.
# STUDIO_SESSION_SECRET = at least 32 random characters.
STUDIO_ACCESS_KEY_HASH=
STUDIO_SESSION_SECRET=

# Required for server-only read/write RPC calls.
# Never expose SUPABASE_SERVICE_ROLE_KEY through NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STUDIO_UNIVERSE_SLUG=
